# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=trades.raw
KAFKA_STARTING_OFFSETS=latest

# Delta Lake
DELTA_OUTPUT_PATH=/opt/workspace/delta-trades-stream-5s-table
CHECKPOINT_PATH=/opt/workspace/checkpoints/delta-trades-stream-5s-table
DELTA_PARTITION_FIELD=hour_id

# Spark
SPARK_APP_NAME=KafkaToDeltaTrades
SPARK_UI_PORT=4050
SPARK_DRIVER_MEMORY=4g

# This controls how many Kafka records are read per trigger
MAX_OFFSETS_PER_TRIGGER=500