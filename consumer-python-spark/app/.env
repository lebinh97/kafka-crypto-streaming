# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=trades.raw
KAFKA_STARTING_OFFSETS=latest

# Iceberg Configuration
ICEBERG_WAREHOUSE_PATH=/opt/consumer-output-iceberg
ICEBERG_CATALOG_NAME=iceberg
ICEBERG_NAMESPACE=crypto
ICEBERG_TABLE_NAME=trades_stream
ICEBERG_PARTITION_FIELD=hour_id
ICEBERG_TARGET_FILE_SIZE=2000
ICEBERG_MIN_INPUT_FILES=1
CHECKPOINT_PATH=/opt/consumer-output-iceberg/checkpoints/crypto-trades-streaming

# Spark
SPARK_APP_NAME=KafkaToIcebergTrades
SPARK_UI_PORT=4050
SPARK_DRIVER_MEMORY=6g
PROCESSING_TRIGGER_INTERVAL=5

# This controls how many Kafka records are read per trigger
MAX_OFFSETS_PER_TRIGGER=5000